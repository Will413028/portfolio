{
  "name": "nextjs-shadcn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && biome check src/",
    "format": "biome format --write",
    "resume:pdf": "typst compile resume/resume.typ public/resume.pdf",
    "covers:gen": "typst compile --ppi 96 --input proj=bfx-funding-bot covers/cover.typ public/images/projects/bfx-funding-bot.png && typst compile --ppi 96 --input proj=divego covers/cover.typ public/images/projects/divego.png",
    "check:deps": "knip --no-exit-code",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.3.3",
    "next-intl": "^4.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.25.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
