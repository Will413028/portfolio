{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && biome check --error-on-warnings src/",
    "format": "biome format --write",
    "resume:pdf": "typst compile resume/resume.typ public/resume.pdf",
    "covers:gen": "typst compile --ppi 96 --input proj=bfx-funding-bot covers/cover.typ public/images/projects/bfx-funding-bot.png && typst compile --ppi 96 --input proj=divego covers/cover.typ public/images/projects/divego.png",
    "check:deps": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile=vitest-report.json && node scripts/check-test-count.mjs vitest-report.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "18.7.2",
    "knip": "^5.88.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  }
}
