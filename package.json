{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && biome check src/",
    "format": "biome format --write",
    "resume:pdf": "typst compile resume/resume.typ public/resume.pdf",
    "covers:gen": "typst compile --ppi 96 --input proj=bfx-funding-bot covers/cover.typ public/images/projects/bfx-funding-bot.png && typst compile --ppi 96 --input proj=divego covers/cover.typ public/images/projects/divego.png",
    "check:deps": "knip --no-exit-code",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "knip": "^5.88.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
